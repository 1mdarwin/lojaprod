define('FERIALIVE', 'live');
define('FERIATEST', 'sandbox');



/**
 * @file
 * Implements PayPal Website Payments Standard in Drupal Commerce checkout.
 */
function feria_menu(){
  $items = array();
  
  $items['feria/registro'] = array(
    'title' => t('Registro de visitas'),
    'description' => t('This page is for adjust the values between Municipality and Diners'),
    'page callback' => 'drupal_get_form',
    'page arguments' => array('registro_form'),    
    'access arguments'  => array('administer feria'),
    'file' => 'feria.inc',
    'access callback'  => 'user_access',
    'type' => MENU_NORMAL_ITEM,     

    );
  $items['feria/win'] = array(
    'title' => t('Canasta !!!'),
    'description' => t('This is a test for menu from payment method postpay'),
    'page callback' => 'presenta_ganador',
    'access callback'  => TRUE,
    'file' => 'feria.inc',
    'type' => MENU_NORMAL_ITEM,     

    );
 
  return $items;
}
/**
* HOOK permission
*/
function feria_permission(){
  return array(
    'administer feria' => array(
      'title' => t('Administración de Registro'),
      'description' => t('Permitir acceso para registrarse con sesion iniciada'),
      ),    
    );
}

