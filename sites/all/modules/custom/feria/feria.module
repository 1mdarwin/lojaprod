/**
 * Returns the URL to the specified PayClub server.
 *
 * @param $server
 *   Either sandbox or live indicating which server to get the URL for.
 *
 * @return
 *   The URL to use to submit requests to the PayClub server.
 */
function feria_server_url($server) {
  switch ($server) {
    case 'sandbox':
      return 'https://www3.optar.ec/webmpi/vpos';
      // return 'https://www3.interdinmpi.com.ec/webmpi/qvpos?'; // valid
    case 'live':
      return 'https://www.optar.com.ec/webmpi/vpos';
      //return 'https://www.interdinmpi.com.ec/webmpi/qvpos?'; // valid
  }
}
