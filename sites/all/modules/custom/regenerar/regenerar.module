<?php
/**
 * Implements HOOK_menu [regenerar_menu description]
 * @return array menu values
 */
function regenerar_menu(){
	$items['regenerar/consulta'] = array(
		'title' => 'Regenerar - Consulta de valores',
		'page callback' => 'drupal_get_form',
		'page arguments' => array('regenerar_form'),
		'access callback' => true,
		//'access arguments' => array('administer updgim'),
		'type' => MENU_NORMAL_ITEM,
		'file' => 'regenerar.inc'
	);
	$items['regenerar/resultado'] = array(
		'title' => t('Regenerar - resultado de la consulta'),  
		'description' => t('Valores de regenerar del Municipio de Loja'),
		'page callback' => 'resultado_page',
		'access callback' => true,
		'file' => 'regenerar.inc',
		'type' => MENU_DEFAULT_LOCAL_TASK,
  );

	return $items;
}
