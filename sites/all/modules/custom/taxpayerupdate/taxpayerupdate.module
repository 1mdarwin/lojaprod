/**
 * HOOK_help
 */
function taxpayerupdate_help($path, $arg){
    $help = '';
    switch ($path) {
        case 'admin/help#taxpayerupdate':
            $help = "<h1>Ayuda para Taxpayer Update GIM </h1>";
            $help .= '<ul>';
            $help .= '<li>' . t('Allow to get information using cedula and consume soap webservices from java system</br>') . '</li>';
            $help .= '<li>' .t('This information will be send to moderator for update information</br>') . '</li>';
            $help .= '<li>' .t('Build a Excel datasheet') . '</li>';
            $help .= '</ul>';
            break;
        
        default:
            # code...
            break;
    }  
    return $help;    
}

