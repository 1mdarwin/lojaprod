/**
 * Implements hook_default_wsclient_service().
 */
function taxpayerupdate_default_wsclient_service() {    
    
    $services = array();
    
    $service = new WSClientServiceDescription();
    $service->name = 'taxpayer';
    $service->label = 'TaxPayer Update';
    $service->url = ENDPOINT_GIM;
  //  $service->url = 'http://190.57.168.199:8080/gim/paymentPlatform?wsdl';
    $service->type = 'soap';
        
    try {
      $service->endpoint()->initializeMetaData();
      $services[$service->name] = $service;
    }
    catch (WSClientException $e) {
      watchdog('wsclient', $e->__toString());
    } 
    return $services;
  
  }

  /**
* Send a mail 
* HOOK_mail
*/
function taxpayerupdate_mail($key, &$message, $params){
    global $user;
    $usuario = $user->name;
    switch ($key) {
      case 'taxpayer':
        //$message['to'] = $user->mail;
        watchdog('TaxpayerUpdate','Mail for update taxpayer sent to :mailto', array(':mailto'=>$usuario), WATCHDOG_DEBUG);
        $message['subject'] = t('Solicitud de actualizar contribuyente');
        $message['body'][] = '<div>'. t('Hola @username,', array('@username' => 'operador')) . '</div>';
        $message['body'][] = '<div><strong>'.t('Datos recibidos: ').'</strong></div>';
        $message['body'][] = '<div>' . t('Cedula: ') . $params['cedula'] . '</div>';
        $message['body'][] = '<div>' . t('Nombres: ') . $params['lastname'] . '</div>';
        $message['body'][] = '<div>' . t('Correo: ') . $params['email'] . '</div>';
        $message['body'][] = '<div>' . t('Direccion: ' . $params['address']) .'</div>';
        $message['body'][] = '<div>' . t('Telefono: ' . $params['phone']) . '</div>';        
        $message['body'][] = '<br/><strong>' . t('Municipio de Loja.') . '</strong>';
        break;     
      default:
        # code..success .
        break;
    }
  }
  
