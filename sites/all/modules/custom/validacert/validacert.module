/*
 * HOOK Help
 */
function validacert_help($path, $arg){
  $help = '';
  switch ($path) {
    case 'admin/help#validacert':
      $help = "<h1>Ayuda para Valida documentos </h1>";
      $help .= t('This module is for get taxes from citizens</br>');
      $help .= t('This module work with two webservices, from GIM and AGP systems</br>');
      $help .= t('Include payments too');
      break;
    
    default:
      # code...
      break;
  }  
  return $help;
}
