<?php

/**
 * @file
 * Web service client examples module.
 */
/*
 * HOOK Help
 */
function cem_help($path, $arg){
  $help = '';
  switch ($path) {
    case 'admin/help#cem':
      $help = "<h1>Ayuda para Impuesto GIM </h1>";
      $help .= t('This module is for get debts from citizens for project CEM</br>');
      $help .= t('This module work with one table imported from Excel file (csv)</br>');      
      break;
    
    default:
      # code...
      break;
  }  
  return $help;
}
/*
 * Implmentation HOOK Menu
 */

function cem_menu(){
        // Para mantenimiento se cambia el texto a consultando, caso contrario consulta 
  $items['cem/consulta'] = array(
    'title' => t('Consulta de cem'),
    'description' => t('Consultar sus cem con su número de cédula'),
    'page callback' => 'drupal_get_form',
    'page arguments' => array('consulta_cem_form'),
    //'access arguments' => array('access content'),
    'access callback' => true,
    'file' => 'cem.inc',
    'type' => MENU_NORMAL_ITEM,
  ); 
  $items['admin/config/cem'] = array(
    'title' => t('cem Settings'),
    'description' => t('Enable/Disabled options for cem query'),
    'page callback' => 'drupal_get_form',
    'page arguments' => array('cem_admin_form'),
    'access arguments'  => array('administer cem'),
    'access callback'  => 'user_access',
    'type' => MENU_NORMAL_ITEM,
    'file' => 'cem.inc',
  );
  
  $items['cem/consulta/resultado'] = array(
      'title' => t('Resultado de la consulta'),  
      'description' => t('cem que adeuda al Municipio de Loja'),
      'page callback' => 'resultado_page',
      'access callback' => true,
      'file' => 'cem.inc',
      'type' => MENU_DEFAULT_LOCAL_TASK,
  );
  $items['cem/consulta/test'] = array(
      'title' => t('Resultado de la consulta (test)'),
      'description' => t('cem que adeuda al Municipio de Loja'),
      'page callback' => 'test_page',
      'access callback' => true,
      'file' => 'cem.inc',
      'type' => MENU_NORMAL_ITEM,
  );

  // Renombrar para mantenimiento lo que se encuenta en los corchetes
  $items['cem/consultam'] = array(
      'title' => t('Mantenimiento del servicio CEM'),  
      'description' => t('Mantenimiento periodico del servicio de consulta'),
      //'page callback' => 'mantenimientos',
      'page callback' => 'cierreanio_cem',
      'access callback' => true,
      'type' => MENU_DEFAULT_LOCAL_TASK,
  );
  
  return $items;  
}

/*
 * Implmentation HOOK block_info
 */
function cem_block_info(){
  $blocks = array();
  $blocks['cem'] = array(
      'info'=>'Consulta de cem'
  );
  return $blocks;
}
/*
 * Implmentation HOOK block_view
 */
function cem_block_view($delta = ''){
  $blocks = array();
  switch ($delta) {
    case 'cem':
      $blocks['subject'] = t('Consulta cem');
      $blocks['content'] = drupal_get_form('consulta_form_block');      
      /*$blocks['content'] = array(
          'page callback' => 'drupal_get_form',
          'page arguments' => array('consulta_form'),
      );
      */
      break;
  }
  return $blocks;
}
/*
 * Call function for render the block form
 */
function consulta_cem_form_block($form, &$form_state){  
  $form['cons'] = array(
      '#title' => t(''),
      '#type' => 'fieldset',
//      '#description' => t('Consulta a traves de su cedula')
  );
  $form['cons']['cedula'] = array(
      '#title' => t('Número de cédula'),
      '#type' => 'textfield',
      '#required' => true,
      '#maxlenght' => 10,
      '#size' => 15,
      '#description' => t('Digite solo numeros'),
	);
  $form['cons']['save'] = array(
      '#prefix' => '<div class="consulta">',
      '#type' => 'submit',
      '#value' => t('Consultar'),
  ); 
  //$form['#theme'] = array('consulta_form_block');
	
  return $form;
}

/**
* Allow to disabled the taxes query during end of year
* @return $mensaje;
*/
function cierreanio_cem(){	 
	$mensaje  = variable_get('message_cem','Suspendido');	
	return $mensaje;
}

