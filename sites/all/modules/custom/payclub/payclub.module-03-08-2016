/**
* FILL array with data from PAYCLUB
* @param $pluginr
*   Array returned from PayClub
* @return $ipnr
*   Return an array with $ipn for send it to another function
*/
function fillIPN ($plug){
  $ipnr = array();
  if(isset($plug)){
    $ipnr['AUTHORIZATIONSTATE'] = $plug->getAuthorizationState();
    $ipnr['AUTHORIZATIONCODE'] = $plug->getAuthorizationCode();
    $ipnr['ERRORCODE'] = $plug->getErrorCode();
    $ipnr['ERRORDETAILS'] = $plug->getErrorDetails();

    $ipnr['TransacctionID'] = $plug->getTransacctionID();
    $ipnr['TransacctionValue'] = $plug->getTransacctionValue();
  }
  return $ipnr;
}


