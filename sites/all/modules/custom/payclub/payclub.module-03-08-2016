function concilia_form_submit($form, &$form_state){
  $fec = $form_state['values']['fecha']." 08:00:00";
  $fecm = $form_state['values']['fecha']." 23:00:00";
  $txns = db_query('SELECT * 
                  FROM payclub_vpos pc                  
