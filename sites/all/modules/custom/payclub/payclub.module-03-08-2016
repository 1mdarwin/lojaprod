/**
* Payment method callback: process an IPN once it's been validated.
*/
function payclub_ipn_process_ec($order, $payment_method, &$ipn){
  // Exit when we don't get a payment status we recognize.
  
  // If this is a prior authorization capture IPN for which we've already
  $transactions = commerce_payment_transaction_load_multiple(array(), array('order_id' => $order->order_id));
  if (count($transactions) > 0) {
    $transaction = end($transactions);

    // The next line could be for Autorization Code from VPOS
    $transaction->remote_id = $ipn['vpos_aut'];
    //$transaction->amount = commerce_currency_decimal_to_amount($ipn['TransacctionValue'],'USD');
    watchdog('payclub','Monto guardado: @txn_monto',array('@txn_monto'=> $transaction->amount),WATCHDOG_INFO);
    $transaction->amount = $ipn['vpos_total'];
    watchdog('payclub','Monto de transaccion tomado de vpos_total: @txn_monto',array('@txn_monto'=> $transaction->amount),WATCHDOG_INFO);
    //$transaction->amount = number_format($ipn['TransacctionValue'],2,'.','');
    $transaction->currency_code = 'USD'; //$ipn['CurrencyID'];
    $transaction->payload[REQUEST_TIME . '-ipn'] = $ipn;

    // Set the transaction's statuses based on the IPN's payment_status.
    $transaction->remote_status = $ipn['vpos_tipo'];

    // If we didn't get an approval response code...
    switch ($ipn['vpos_tipo']) {
      case 'N':
        $transaction->status = COMMERCE_PAYMENT_STATUS_FAILURE;
        $transaction->message = t("The payment has failed. This happens because the bank couldn't process your transaction due to : @errorcode , @errordetails", array('@errorcode' => $ipn['ERRORCODE'], '@errordetails' => $ipn['ERRORDETAILS']));
        drupal_set_message(t($ipn['ERRORDETAILS']),'warning');
        commerce_payment_redirect_pane_previous_page($order);
        break;    

      case 'P':
        $transaction->status = COMMERCE_PAYMENT_STATUS_SUCCESS;
        $transaction->message = t('The payment has completed with Autorization Code: @ac and Transaction @txn', array('@ac' => $ipn['vpos_aut'],'@txn'=> $transaction->transaction_id));
//        $transaction->message = t('The payment has completed with Autorization Code: @ac', array('@ac' => $ipn['vpos_aut']));
//        watchdog('payclub','Procesando transaccion, estado pagado',array(),WATCHDOG_INFO);
        break;

      case 'Refunded':
        $transaction->status = COMMERCE_PAYMENT_STATUS_PENDING;
        $transaction->message = t('Refund for transaction @txn_id', array('@txn_id' => $ipn['parent_txn_id']));
        break;
    }

    // Save the transaction information.
    commerce_payment_transaction_save($transaction);
    $ipn['transacction_id'] = $transaction->transaction_id;

    // FUNCTION FOR CONTINUE WITH THE NEXT PAGE
    commerce_payment_redirect_pane_next_page($order);
    watchdog('payclub', 'Payment processed for Order @order_number with Transaction ID @txn_id.', array('@txn_id' => $ipn['vpos_txn_id'], '@order_number' => $order->order_number), WATCHDOG_INFO);
  }
  
}
