 		  AND pc.vpos_flag = 1',
                  array('fec' => $fec, 'fecm' => $fecm))->fetchall();
  $txns = json_decode(json_encode($txns), true);
  $txns = prepareDataCSV($txns);
  //write_csv($list);  
  write_csv($txns,get_DateStr($form_state['values']['fecha']));  
}
/**
* Get Only Date from String
*/
function get_DateStr($f){
  return preg_replace('/[-]*/','',substr($f,0,10));
}
/**
* Get Only Time from String
*/
function get_TimeStr($f){
  return preg_replace('/[:]*/','',substr($f,11,9));
}
/**
* Build csv file wity databaase query
* @param $datos
*   Array with transaction data
* @param $fecha
*   Date choose from form for build the file csv
*/
function write_csv($datos,$fecha){
  drupal_add_http_header('Content-Type', 'text/csv');
  //drupal_add_http_header('Content-Disposition', 'attachment;filename='.RUC.'_'.$fecha.'.csv');
  drupal_add_http_header('Content-Disposition', 'attachment;filename=1160000240001_'.$fecha.'.csv');

  $fp = fopen('php://output', 'w');
  foreach($datos as $line){
    fputcsv($fp, $line);
  }
  fclose($fp);
  drupal_exit();
}
/**
* Fill array with sort data from DB and append some elements for text file (csv)
* @param $data
*   Array with data for add some elements in array
*/
function prepareDataCSV($data){
  $fw = array();
  $len = sizeof($data);
  for($i=0;$i<$len;$i++){
    $fw[$i][0] = get_DateStr($data[$i]['vpos_fec']);
    $fw[$i][1] = get_TimeStr($data[$i]['vpos_fec']);
    $fw[$i][2] = $data[$i]['vpos_txn_id'];
    $fw[$i][3] = $data[$i]['vpos_cct'];
    //$fw[$i][4] = $data[$i]['vpos_subtotal'];
    $fw[$i][4] = number_format($data[$i]['vpos_subtotal'],2);
    $fw[$i][5] = empty($data[$i]['vpos_iva']) ? '0.00' : $data[$i]['vpos_iva'];
    //$fw[$i][5] = '0.00'; //$data[$i]['vpos_iva'];
    $fw[$i][6] = '0.00'; //$data[$i]['vpos_ice'];
    $fw[$i][7] = '0.00'; //$data[$i]['vpos_interes'];
    //$fw[$i][8] = $data[$i]['vpos_total'];
    $fw[$i][8] = number_format($data[$i]['vpos_total'],2);
    $fw[$i][9] = $data[$i]['vpos_aut'];
    $fw[$i][10] = RUC;
    $fw[$i][11] = $data[$i]['vpos_tc'];
    $fw[$i][12] = $data[$i]['vpos_mes'];
    $fw[$i][13] = $data[$i]['vpos_tipo'];
    $fw[$i][14] = '';
    $fw[$i][15] = '';
  }
  return $fw;
}
