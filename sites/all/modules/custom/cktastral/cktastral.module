/**
 * HOOK MENU
 */
function cktastral_menu(){
  $items = array();
  $items['ktastro/consulta'] = array(
    'title' => t('Consulta de Cédula Catastral'),
    'description' => t('Permite la consulta de catastro por numero de cedula'),
    'page callback' => 'drupal_get_form',
    'page arguments' => array('catastro_form'),
    'access callback' => 'user_access',
    //'access callback' => TRUE,
    'access arguments' => array('administer consultar'),
    'file' => 'cktastral.inc',
    'type' => MENU_LOCAL_TASK,
  );
  $items['ktastro/test'] = array(
    'title' => t('Test de la consulta'),
    'description' => t('Test for cktastral custom module'),
    'page callback' => 'test_page_ktastro',
    'access callback' => true,
    'file' => 'cktastral.inc',
    'type' => MENU_DEFAULT_LOCAL_TASK,
  );
  $items['ktastro/codes'] = array(
    'title' => t('Códigos de Propiedades'),
    'description' => t('Test for cktastral custom module'),
    'page callback' => 'show_table_codes',
    'access callback' => 'user_access',
    'access arguments' => array('administer codes'),
    'file' => 'cktastral.inc',
    'type' => MENU_LOCAL_TASK,
  );
  $items['ktastro/code/%'] = array(
    'title' => t('Cédula catastral'),
    'description' => t('Test for cktastral custom module'),
    'page callback' => 'show_property',
    'page arguments' => array(1),
    'access callback' => true,
    'file' => 'cktastral.inc',
    'type' => MENU_LOCAL_TASK,
  );
  $items['ktastro/code/%/pdf'] = array(
    'title' => t('Descarga PDF'),
    'description' => t('Test for cktastral custom module'),
    'page callback' => 'imprime_cktastral',
    'page arguments' => array(1),
    'access callback' => true,
    'file' => 'cktastral.inc',
    'type' => MENU_LOCAL_TASK,
  );
  return $items;
}
/**
* HOOK permission
* Allow to access to URL if it has permission
*/
function cktastral_permission(){
  return array(
    'administer consultar' => array(
      'title' => t('Acceso consulta cedula catastral'),
      'description' => t('Permitir consultar cedula catastral'),
      ),    
    'administer codes' => array(
      'title' => t('Acceso a codes de propiedad'),
      'description' => t('Permitir acceso a códigos de propiedad'),
      ),     
    );
}



