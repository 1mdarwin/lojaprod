function emoney_submit_form_submit($payment_method, $pane_form, $pane_values, $order, $charge) {
  $order->data['emoney'] = $pane_values;
}
/**
* CALLBACK submit form validate
**/
function emoney_submit_form_validate($payment_method, $pane_form, $pane_values, $order, $form_parents = array()) {
  $wrapper = entity_metadata_wrapper('commerce_order',$order);
  $currency_code = 'USD';
  $order_currency_code = $wrapper->commerce_order_total->currency_code->value();
  $amount = $wrapper->commerce_order_total->amount->value();
  $amount = number_format(floatval($amount)/100,2);

  $serv = wsclient_service_load('emoney');
  $fechahoy = 'muni-'. strtotime(date('Y-m-d H:i:s')); // unix format
  $ced = $pane_values['ced'];
  $cell = $pane_values['cell'];
  
  
  $cash = new stdClass();
  $cash->dtoRequestCobroPre = new stdClass();
  
  $cash->dtoRequestCobroPre->amount = $amount;
  $cash->dtoRequestCobroPre->brandId = 1;
  $cash->dtoRequestCobroPre->currency = 1;
  $cash->dtoRequestCobroPre->document = $ced;
  $cash->dtoRequestCobroPre->language = "ES";
  $cash->dtoRequestCobroPre->msisdnSource = $cell;
  $cash->dtoRequestCobroPre->msisdnTarget = IDUSER_BCE;
  $cash->dtoRequestCobroPre->password = PASSUSER_BCE;
  $cash->dtoRequestCobroPre->pin = PASSUSER_BCE;
  $cash->dtoRequestCobroPre->user = IDUSER_BCE;
  $cash->dtoRequestCobroPre->utfi = $fechahoy;
  try{
    $result = $serv->cobroPre($cash);
  }catch (WSClientException $f){
    echo $f;
  }
  if(!empty($result)){
    dsm($result);
    switch($result->return->codeErrorId){
    case '104': $mesg = form_set_error('ced', $result->return->resultText); return false;
    case '034': $mesg = form_set_error('cell', $result->return->resultText); return false;
    default: break;
    } 
  }

  if(strlen($ced) < 10){
    form_set_error('ced', t('Debe digitar un número de cedula valido'));
    return false;
  }
  if(strlen($cell) != 10){
    form_set_error('ced', t('Debe digitar un número de celular valido'));
    return false;
  }
  dsm($order);
}
