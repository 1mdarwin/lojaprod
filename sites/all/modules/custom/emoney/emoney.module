/**
* 
*/
function emoney_form_commerce_checkout_form_alter(&$form, &$form_state) {
  // If this checkout form contains the payment method radios...

  if(!empty($form['commerce_payment']['payment_method']['#options'])){
    // Loop over its options array looking for a E-money option
    foreach($form['commerce_payment']['payment_method']['#options']as $key => &$value){
      list($method_id, $rule_name) = explode('|', $key);
      // If we find E-money...
      if($method_id == 'emoney'){
        $icons = emoney_icons();
        $value = t('!logo', array('!logo' => $icons['emoney']));
	$value .= '<p>'.t('E-money Central Bank - pay securely without sharing your financial information through Electronic Money').'</p>';
	# $form['commerce_payment']['payment_method']['attached']['css'][] = drupal_get_path('module','emoney').'/theme/emoney.theme.css';
        break;
      }
    }
  }

}
/**
 * Returns an array of PayPal payment method icon img elements.
 *
 * @param $methods
 *   An array of PayPal payment method names to include in the icons array; if
 *   empty, all icons will be returned.
 *
 * @return
 *   The array of themed payment method icons keyed by name: visa, mastercard,
 *   amex, discover, echeck, paypal
 */
function emoney_icons($methods = array()) {
  $icons = array();

  foreach (emoney_payment_methods() as $name => $title) {
    if (empty($methods) || in_array($name, $methods, TRUE)) {
      $variables = array(
        'path' => drupal_get_path('module', 'emoney') . '/images/' . $name . '.gif',
        'title' => $title,
        'alt' => $title,
        'attributes' => array(
          'class' => array('paypalclub-icon'),
        ),
      );
      $icons[$name] = theme('image', $variables);
    }
  }

  return $icons;
}
/**
* Payment Methods
*/
function emoney_payment_methods() {
  return array(
    'visa' => t('Visa'),
    'discover' => t('Discover'),
    'diners' => t('Diners Club'),
    'emoney' => t('Electronic Money'),
  );
}

/**
 * Payment method callback: redirect form, a wrapper around the module's general
 *   use function for building a WPS form.
 */
function emoney_redirect_form($form, &$form_state, $order, $payment_method) {
  // Return an error if the enabling action's settings haven't been configured.
  if (empty($payment_method['settings']['username'])) {
    drupal_set_message(t('E-Money EC is not configured for use. No E-Money username has been specified and other parameters.'), 'error');
    return array();
  }

  $settings = array(
    // Return to the previous page when payment is canceled
    'cancel_return' => url('checkout/' . $order->order_id . '/payment/back/' . $order->data['payment_redirect_key'], array('absolute' => TRUE)),

    // Return to the payment redirect page for processing successful payments
    'return' => url('checkout/' . $order->order_id . '/payment/return/' . $order->data['payment_redirect_key'], array('absolute' => TRUE)),

    // Specify the current payment method instance ID in the notify_url
    'payment_method' => $payment_method['instance_id'],

    // Include the application indicator
    'bn' => $payment_method['buttonsource'],
  );

  return emoney_order_form($form, $form_state, $order, $payment_method['settings'] + $settings);

}

/**
 * Builds a Website Payments Standard form from an order object.
 *
 * @param $order
 *   The fully loaded order being paid for.
 * @param $settings
 *   An array of settings used to build out the form, including:
 *   - server: which server to use, either sandbox or live
 *   - local_id: the PayClub Local ID for Municipality the payment submits to
 *   - cancel_return: the URL PayClub should send the user to on cancellation
 *   - return: the URL PayClub should send the user to on successful payment
 *   - currency_code: the PayClub currency code to use for this payment if the
 *     total for the order is in a non-PayPal supported currency
 *   - language: the PayClub language code to use on the payment form
 *   - payment_action: the PayClub payment action to use: sale, authorization,
 *     or order
 *   - payment_method: optionally a payment method instance ID to include in the
 *     IPN notify_url
 *
 * @return
 *   A renderable form array.
 */
function emoney_order_form($form, &$form_state, $order, $settings) {
   $wrapper = entity_metadata_wrapper('commerce_order',$order); 
   $currency_code = 'USD';
   $order_currency_code = $wrapper->commerce_order_total->currency_code->value();
   $amount = $wrapper->commerce_order_total->amount->value();
   $amount = number_format(floatval($amount)/100,2);
   
   $cell = $order->data['emoney']['cell'];
   $ced = $order->data['emoney']['ced'];

   // Create new transaction with status pending for send to gateway payclub
   $transaction = commerce_payment_transaction_new('emoney', $order->order_id);
   $transaction->amount = $amount;
   $transaction->currency_code = $currency_code;
   $transaction->status = COMMERCE_PAYMENT_STATUS_PENDING;
   //$transaction->instance_id = $payment_method['instance_id'];
   $transaction->instance_id = 'emoney|commerce_payment_emoney';
   
   commerce_payment_transaction_save($transaction);

  // Ensure a default value for the payment_method setting.

   $vpos = array();
   $vpos['vpos_fec'] = Date("Y-m-d H:i:s");
   $vpos['vpos_txn_id'] = $transaction->transaction_id;
   $vpos['vpos_ced'] = $_SESSION['ced'];
   $vpos['vpos_bondsid'] = implode(',',$_SESSION['bondsid']);
   $vpos['vpos_bond_num'] = implode(',',$_SESSION['bondsNum']);
   $vpos['vpos_cct'] = '';
   $vpos['vpos_subtotal'] = $amount;
   $vpos['vpos_iva'] = '';
   $vpos['vpos_ice'] = '';
   $vpos['vpos_interes'] = '';
   $vpos['vpos_total'] = 0.00;
   $vpos['vpos_aut'] = ''; // cell
   $vpos['vpos_tc'] = 'EM'; // EM :: Electronic Money
   $vpos['vpos_mes'] = '';
   $vpos['vpos_tipo'] = '';
   $vpos['vpos_flag']= 1; // 1 no check with conciliation payclub

   // Save before send to VPOS to local vpos table
   drupal_write_record('payclub_vpos',$vpos);
   
   $data = array(
      'ced' => $ced,
      'order_id' => $order->order_id,
      'amount' => $amount,
      'cell' => $cell,
   );

   // Allow modules to alter parameters of the API request.
   drupal_alter('emoney_order_form_data', $data, $order);

   //Enable this line when the payment is ready :: DRW
  $form['#action'] = "http://www.loja.gob.ec/emoney/process";

  foreach ($data as $name => $value) {
    if (!empty($value)) {
      $form[$name] = array('#type' => 'hidden', '#value' => $value);
    }
  }

//  commerce_payment_transaction_save($transaction);
  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Processing transaction with Central Bank'),
  );

  return $form;
}
