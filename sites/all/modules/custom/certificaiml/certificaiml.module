  /**
  *   HOOK menu 
  */
  function certificaiml_menu(){    
    $items['certificados/testpage'] = array(
      'title' => t('Pagina de Prueba de Certificados'),
      'description' => t('Cerficados'),
      'page callback' => 'testpage',
      'access callback'  => TRUE,
      'file' => 'certificaiml.inc',
      'type' => MENU_DEFAULT_LOCAL_TASK,      
    );     
    $items['certificados/consulta'] = array(
      'title' => t('Certificado de no Adeudar'),
      'description' => t('Cerficados'),
      'page callback' => 'drupal_get_form',
      'page arguments' => array('consultacer_form'),
    //'access arguments' => array('access content'),
      'access callback' => true,
      'file' => 'certificaiml.inc',
      'type' => MENU_NORMAL_ITEM,
      
    );
    $items['certificados/res'] = array(
      'title' => t('Resultado de la consulta'),
      'description' => t('Cerficados'),
      'page callback' => 'res',
      'access callback'  => TRUE,
      'file' => 'certificaiml.inc',
      'type' => MENU_DEFAULT_LOCAL_TASK,      
    );   

    return $items;
  }
  
  
