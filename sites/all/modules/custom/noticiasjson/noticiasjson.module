function noticiasjson_menu() {
  $items = array();

  $items['noticiasjson'] = array(
    'title' => 'Noticias JSON',
    'page callback' => 'get_noticias',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );
  $items['noticiasxml'] = array(
    'title' => 'Noticias XML',
    'page callback' => 'get_noticiasxml',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  return $items;
}
function noticiasjson_page() {
