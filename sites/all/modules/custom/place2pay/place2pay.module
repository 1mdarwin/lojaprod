/**
* HOOK HELP
*/
function place2pay_help($path, $arg){
	$help = '';
	switch ($path) {
		case 'admin/help#infoperson':
			$help = "<h1>Actualiza información del contribuyente al sistema de recaudacion GIM</h1>";
			$help .= t('This module is for get taxes from citizens</br>');
			$help .= t('This module work with two webservices, from GIM and AGP systems</br>');
			$help .= t('Include payments too');
			break;
		default:
      	# code...
      	break;
  	}
  	return $help;
}
