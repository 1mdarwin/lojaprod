/**
* Send a mail 
* HOOK_mail
*/
function place2pay_mail($key, &$message, $params){
  global $user;
  $usuario = $user->name;
  switch ($key) {
   case 'success':
      watchdog('GIM','Mail success sent to :mailto', array(':mailto'=> $usuario), WATCHDOG_DEBUG);
      $message['subject'] = t('PAGO GIM :: Exitoso');
      $message['body'][] = t('<h2>Hola Administrador</h2>');
      $message['body'][] = t('<p>El pago en el sistema GIM fue exitoso.</p>');
      $message['body'][] = t('Gracias por utilizar estos servicios.');
      $message['body'][] = t('<p>Municipio de Loja.</p>');
      break;
   case 'concilliation':
      watchdog('Concilliation','Mail success sent to :mailto', array(':mailto'=> $usuario), WATCHDOG_DEBUG);
      $message['subject'] = t('PAGO CONCILIADO - Orden Nro: ').$params['id_order'];
      $message['body'][] = t('<h2>Hola Administrador</h2>');
      $message['body'][] = t('<p>La transacción ha sido conciliada en el sistema GIM y place2pay.</p>');
      $message['body'][] = t('La orden número: ').$params['id_order'] .'<br/>';
      $message['body'][] = t('Autorizacion: ').$params['aut'] .'<br/>';
      $message['body'][] = t('Tarjeta: ').$params['cct'] .'<br/>';
      $message['body'][] = t('Total: ').$params['total'] .'<br/>';
      $message['body'][] = t('requestId: ').$params['requestId'] .'<br/>';
      $message['body'][] = t('<p>Gracias por utilizar estos servicios</p>');
      $message['body'][] = t('<p>Municipio de Loja.</p>');
      break;
    default:
      # code..success .
      break;
  }
}

