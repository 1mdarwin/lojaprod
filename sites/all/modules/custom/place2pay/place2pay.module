/**
 * Implements hook_commerce_payment_method_info().
 */
function place2pay_commerce_payment_method_info() {
  $payment_methods = array();

  $payment_methods['place2pay_ec'] = array(
    'base' => 'place2pay',
    'title' => t('Placetopay Ecuador'),
    'short_title' => t('Placetopay EC'),
    'description' => t('Place2pay EC Payments Standard OFF-SITE'),
    'display_title' => t('Payments with Placetopay'),
    //'terminal' => FALSE,
    'offsite' => TRUE, // avoid to redirect 
    'offsite_autoredirect' => TRUE, // avoid to redirect    

    // Because the order form generation code does not have access to a payment
    // method info array, we set the bn directly there instead of making use of
    // this buttonsource variable. It's here for consistency with other payment
    // methods in this package.
    'buttonsource' => 'CommerceGuys_Cart_PPS',
  );

  return $payment_methods;
}

/**
 * This form allows to show all payments method before to redirect the off-site payments
 * Implements hook_form_FORM_ID_alter().
 * 
 */
function place2pay_form_commerce_checkout_form_alter(&$form, &$form_state) {
  global $user, $base_url;
  $account = user_load($user->uid);
  $checkout_page = $form_state['checkout_page'];
  $order = $form_state['order']; //Loading from form_status
  //dsm($checkout_page);
  //dsm($form);
  //dpm(module_implements('commerce_checkout_complete'));
  //watchdog('place2pay','***********  Antes de ingresar  ***************', array(), WATCHDOG_DEBUG);
  if($form['#form_id'] == "commerce_checkout_form_checkout"){    
    //$form['buttons']['continue']['#validate'][] = 'place2pay_validate_check'; // validate data billing information
    watchdog('place2pay','** Formulario checkout_checkout (datos facturacion) **', array(), WATCHDOG_INFO);
    $orderid = commerce_cart_order_id($user->uid);
    $order = commerce_order_load($orderid);
    // Creating a customer profile and setting temporal information for update later
    $profileBill = commerce_customer_profile_new('billing'); // Create new Billing profile.
    $profileBill->uid = $user->uid;
    $profileBill->commerce_customer_address[LANGUAGE_NONE][0]['country'] = 'EC';
    $nombres = (isset($account->field_name_full['und'][0]['value'])? $account->field_name_full['und'][0]['value'] : 'Usuario Autenticado');
//    $nombres = $account->field_name_full['und'][0]['value']; // Nombre Completo
//    $profileBill->commerce_customer_address[LANGUAGE_NONE][0]['name_line'] = 'DarwinSito Betancourt';
    $profileBill->commerce_customer_address[LANGUAGE_NONE][0]['name_line'] = $nombres;
    $profileBill->commerce_customer_address[LANGUAGE_NONE][0]['thoroughfare'] = 'Loja';
    $profileBill->commerce_customer_address[LANGUAGE_NONE][0]['locality'] = 'Loja';
    commerce_customer_profile_save($profileBill); // Saving new profile.
    $order->commerce_customer_billing[LANGUAGE_NONE][0]['profile_id'] = $profileBill->profile_id; // Change profile id for billing
    commerce_order_save($order);
    $order = commerce_order_status_update($order, 'checkout_'. $checkout_page['next_page'], FALSE, TRUE, t('Redirect review process.'));
    //dsm($order);
    drupal_goto('checkout/' . $order->order_id . '/' . $checkout_page['next_page'] );
  }
  //Check the commerce_checkout_form_review form
  //-------------------------------------------------------------
  if($form['#form_id'] == "commerce_checkout_form_review"){
    watchdog('place2pay','****** Formulario checkout_review (pagos)*****', array(), WATCHDOG_INFO);
    // If this checkout form contains the payment method radios...
    if (!empty($form['commerce_payment']['payment_method']['#options'])) {
      // Loop over its options array looking for a PayPal WPS option.
      foreach ($form['commerce_payment']['payment_method']['#options'] as $key => &$value) {
        list($method_id, $rule_name) = explode('|', $key);      

        // If we find Place2pay EC...
        if ($method_id == 'place2pay_ec') {
          // Prepare the replacement radio button text with icons.
          $icons = place2pay_icons();
          $orderid = commerce_cart_order_id($user->uid);
          //module_load_include('inc','place2pay','place2pay');
          $query = db_query('SELECT * from place2pay WHERE order_id = :orderid ORDER BY fecha DESC',array(':orderid' => $orderid))->fetchAll();
          if (sizeof($query) > 0){ // Check if exist transaction for order ID
             if($query[0]->estado == 'REJECTED'){ // When the user cancel the payment redirect
              $path = $base_url . '/place2pay/'. $orderid .'/fail';
              drupal_goto($path);
            }
          } 
            
          $value = t('!logo', array('!logo' => $icons['place2pay']));
          $value .= '<p>'. t('Placetopay - pague de forma segura sin compartir su información financiera a través de PlacetoPay').' </p>';
            //$value .= '<div class="commerce-payclub-icons"><span class="label">' . t('Includes:') . '</span>' . implode(' ', $icons) . '</div>';

            // Add the CSS.
          $form['commerce_payment']['payment_method']['#attached']['css'][] = drupal_get_path('module', 'payclub') . '/theme/payclub.theme.css';
          break;
        } // end size of
      } // end $method_id
    } // Empty form
  }// End form_id  
}
/**
* Custom function that validate alphanumeric caracters for each personal information field at billing information
* placetopay validate no ascii characteres, neither puntuation
*/
function place2pay_validate_check($form, &$form_state){
  //dsm($form_state);
  $value = $form_state['input']['customer_profile_billing']['commerce_customer_address']['und'][0];
  $nombre = $value['name_line'];
  $direccion = $value['thoroughfare'];
  $ciudad = $value['locality'];
  if(!preg_match("/^[a-zA-Z áéíóúAÉÍÓÚÑñ]+$/",$nombre)){
    form_set_error($value . '[locality]','Caracteres no permitidos en el campo nombre');
  }
  if(!preg_match("/^[a-zA-Z0-9 áéíóúAÉÍÓÚÑñ]+$/",$direccion)){
    form_set_error($value .'[locality]','Caracteres no permitidos en la campo dirección');
  }
  if(!preg_match("/^[a-zA-Z áéíóúAÉÍÓÚÑñ]+$/",$ciudad)){
    form_set_error($value . '[locality]','Caracteres no permitidos en la campo ciudad');
  }
}
