/**
 * Payment method callback: redirect form, a wrapper around the module's general
 *   use function for building a WPS form.
 */
function place2pay_redirect_form($form, &$form_state, $order, $payment_method) {
  // Return an error if the enabling action's settings haven't been configured.
  /*if (empty($payment_method['settings']['local_id'])) {
    drupal_set_message(t('PayClub EC is not configured for use. No PayClub Local ID has been specified and other parameters.'), 'error');
    return array();
  }*/  
  watchdog('place2pay','Redirect form to placetopay platform',array(),WATCHDOG_DEBUG);

  $settings = array(
    // Return to the previous page when payment is canceled
    'cancel_return' => url('checkout/' . $order->order_id . '/payment/back/' . $order->data['payment_redirect_key'], array('absolute' => TRUE)),

    // Return to the payment redirect page for processing successful payments
    'return' => url('checkout/' . $order->order_id . '/payment/return/' . $order->data['payment_redirect_key'], array('absolute' => TRUE)),

    // Specify the current payment method instance ID in the notify_url
    'payment_method' => $payment_method['instance_id'],

    // Include the application indicator
    'bn' => $payment_method['buttonsource'],
  );

  return place2pay_order_form($form, $form_state, $order, $payment_method['settings'] + $settings);
}

/**
 * Builds a Website Payments Standard form from an order object.
 *
 * @param $order
 *   The fully loaded order being paid for.
 * @param $settings
 *   An array of settings used to build out the form, including:
 *   - server: which server to use, either sandbox or live
 *   - local_id: the PayClub Local ID for Municipality the payment submits to
 *   - cancel_return: the URL PayClub should send the user to on cancellation
 *   - return: the URL PayClub should send the user to on successful payment
 *   - currency_code: the PayClub currency code to use for this payment if the
 *     total for the order is in a non-PayPal supported currency
 *   - language: the PayClub language code to use on the payment form
 *   - payment_action: the PayClub payment action to use: sale, authorization,
 *     or order
 *   - payment_method: optionally a payment method instance ID to include in the
 *     IPN notify_url
 *
 * @return
 *   A renderable form array.
 */
function place2pay_order_form($form, &$form_state, $order, $settings) {   
  global $user, $base_url;
  
  $query = db_query('SELECT * from place2pay WHERE order_id = :orderid ORDER BY fecha DESC',array(':orderid' => $order->order_id))->fetchAll();
  watchdog('place2pay', 'Tamano consulta :larray para la orden :ordenid', array(':larray' => sizeof($query), ':ordenid'=>$order->order_id), WATCHDOG_DEBUG);
  if (sizeof($query) > 0){
    check_pendiente($query);
  }
  // Valid payment if exist another transaction with the same CEDULA before to redirect  
  module_load_include('inc','impuestos');
  if(payment_in_process($_SESSION['ced'])){ // Check if exist another transacction with the same Cedula and should be wait eight minutes
    drupal_set_message("Existe un pago en proceso con la misma cédula, espere 8 minutos y vuelva a intentarlo","warning");
    drupal_goto($base_url.'/consulta');  // Redirect to query again    
  }
  // End valid payment

  $wrapper = entity_metadata_wrapper('commerce_order', $order);
  $amount = $wrapper->commerce_order_total->amount->value()/100; // Divide for 100
  $address = $wrapper->commerce_customer_billing->commerce_customer_address->value();
  $payerP2P = $address;
  /*dsm($order);
  dsm($address);  
  dsm($address['name_line']);
  dsm($address['first_name']);

  dsm($address['thoroughfare']);
  dsm($address['locality']);
  dsm($amount);*/
  $usuario = user_load($order->uid);
  module_load_include('inc','place2pay');
  $redirectURL = '';
  do{
      $redirectURL = get_validP2P($payerP2P, $amount, $order); //Get valid URL from placetopay service      
  }while(!isset($redirectURL->requestId));
//  $redirectURL = get_validP2P($payerP2P, $amount, $order); //Get valid URL from placetopay service

  $currency_code = 'USD';
  $order_currency_code = $wrapper->commerce_order_total->currency_code->value();
  $amount = $wrapper->commerce_order_total->amount->value();

  // Create new transaction with status pending for send to gateway place2pay
  $transaction = commerce_payment_transaction_new('place2pay_ec', $order->order_id);
  $transaction->amount = $amount;
  $transaction->currency_code = $currency_code;
  $transaction->status = COMMERCE_PAYMENT_STATUS_PENDING;  
  $transaction->instance_id = 'place2pay_ec|commerce_payment_place2pay_ec';
  
  commerce_payment_transaction_save($transaction);
  $vpos = array();
  $vpos['fecha'] = Date("Y-m-d H:i:s");
  $vpos['txn_id'] = $transaction->transaction_id;
  $vpos['requestId'] = $redirectURL->requestId;
  $vpos['cedula'] = $_SESSION['ced'];
  $vpos['order_id'] = $order->order_id;
  $vpos['user_id'] = $order->uid;
  #revisar cuando son recuperados los datos de la BD
  if(!isset($_SESSION['bondsid'])){
  	$drec = db_query('SELECT cedula, bondsid, bond_num WHERE order_id = :orderid',array(':orderid'=> $order->order_id))->fetchAll();
  	$vpos['bondsid']= $drec[0]->bondsid;
  	$vpos['bond_num']= $drec[0]->bond_num;
   }else{
    $vpos['bondsid'] = implode(',',$_SESSION['bondsid']);
  	$vpos['bond_num'] = implode(',',$_SESSION['bondsNum']);
   }
   $vpos['cct'] = '';
   $vpos['subtotal'] = floatval($amount)/100;
   $vpos['iva'] = '';
   $vpos['ice'] = '';
   $vpos['interes'] = '';
   $vpos['total'] = 0.00;
   $vpos['aut'] = '';
   $vpos['tc'] = '';
   $vpos['mes'] = '';
   $vpos['estado'] = '';   
   $vpos['mensaje'] = '';   
   $vpos['flag']= 0;
   $vpos['gim']= 0;
   $query = db_query('SELECT * from place2pay WHERE order_id = :orderid ORDER BY fecha DESC',array(':orderid' => $order->order_id))->fetchAll();
  //commerce_payment_redirect_pane_previous_page($order); //revisar esta seccion con IF para controlar el PENDING
   
   // Save data to Database before redirect to SITEOFF 
   drupal_write_record('place2pay',$vpos);
  
  // Build the data array that will be translated into hidden form values.  
  
  #$form['#action'] = $redirectURL->processUrl;
  watchdog('place2pay','Se ha redirigido a PlacetoPay para ingreso de tarjeta',array(),WATCHDOG_DEBUG);
  watchdog('place2pay','Url pago :url',array(":url"=>$redirectURL->processUrl),WATCHDOG_DEBUG);

  drupal_goto($redirectURL->processUrl);

  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Proceed to Placetopay Ecuador'),
  );
  return $form;
}
/**
* Check pending payment for show custom message to customer
* @param $query fetch data from query DB
*/
function check_pendiente($query){
  global $user, $base_url;
  // comparar fecha actual con la registrada en la db
  // comprobar el estado del pago
  // actualizar base de datos
  // actualizar postprocess
  // redireccionar a pago pendiente con resumen
  $params = $user->name;
  module_load_include('inc','place2pay','place2pay');
  $reqInf = pendiente($query[0]->requestId);  
  $orderid = $query[0]->order_id;
  if(isset($reqInf)){
    watchdog('place2pay','check_pendiente con requestId :id', array(':id' => $query[0]->requestId), WATCHDOG_DEBUG);
  }
  if ($reqInf->status->status == 'PENDING'){
    //$orderid = $query[0]->order_id;
    watchdog('place2pay','***********  START CHECK PENDING FUNCTION  ***************', array(), WATCHDOG_DEBUG);
    $ipn['id_order'] = $orderid;
    $ipn['cct'] = getAbr($reqInf->payment[0]->paymentMethod);
    $ipn['total'] = $reqInf->payment[0]->processorFields[1]->value;
    $ipn['interes'] = 0;
    $ipn['aut'] = $reqInf->payment[0]->authorization;
    $ipn['tc'] = $reqInf->payment[0]->processorFields[0]->value->type;
    $ipn['mes'] = $reqInf->payment[0]->processorFields[0]->value->installments;
    $ipn['estado'] = $reqInf->status->status; // Return APPROVED, REJECTED, PENDING
    $ipn['mensaje'] = $reqInf->status->message; // Return APPROVED OR REJECTED
    $ipn['flag']= 1; // Cambia de 0 a 1 porque se hizo el getRequestInformation
    $ipn['requestId'] = $query[0]->requestId;
    if (postprocess($ipn) !== FALSE){
      // Do payment only in Commerce
      drupal_mail('place2pay','success',$user->mail, language_default(),$params);
      //echo 'ESTADO=OK';
      watchdog('place2pay','Se imprime OK al VPOS, estado PENDING', array(), WATCHDOG_DEBUG);
      $path = $base_url . '/checkout/'. $orderid .'/review';
      drupal_goto($path);
    }
  }else{   
    if($query[0]->estado == 'REJECTED' || $reqInf->status->status == 'REJECTED'){ // When the user cancel the payment redirect
      watchdog('-- Redirigiendo a cancelacion, estado REJECTED with query DB and requestInformation --', array(), WATCHDOG_INFO);
      $path = $base_url . '/place2pay/'. $orderid .'/fail';
      drupal_goto($path);
    }
  }
  watchdog('place2pay','***********  END CHECK PENDING FUNCTION  ***************', array(), WATCHDOG_DEBUG);
}
/**
* Get Payment details from database
*/
function get_payment_details($id_txn){
  $payment = array();
  $payment = db_query('SELECT * FROM place2pay
                            WHERE txn_id = :id_txn',
                            array(':id_txn' => $id_txn))->fetchAll();
  return $payment;
}

/**
* Alter the order history
*/
function place2pay_entity_view_alter(&$build, $type){
  switch ($type) {
    case 'commerce_order':
      //if ($build['#view_mode'] === 'administrator') {
        $order = $build['#entity'];
        $transactions = commerce_payment_transaction_load_multiple(array(), array('order_id' => $order->order_id));
        //dsm($transactions);
        $tran = end($transactions); // get the last transaction
	      module_load_include('inc','place2pay','place2pay');
        $payment = get_payment_details($tran->transaction_id);
        if(!empty($payment)){
          //dsm($payment);
          $build['status'] = array(
            '#type' => 'fieldset',
            '#title' => t('Payment details'),
            '#weight' => 1,
          );

          $build['status']['markup'] = array(
           '#prefix' => '<ul>',
           '#suffix' => '</ul>',
           array('#markup' => sprintf('<li>'.t('Tarjeta de Crédito:').' %s</li>', get_nameccp2p($payment[0]->cct))),
           array('#markup' => sprintf('<li>Mes (s): %s</li>', $payment[0]->mes)),
           array('#markup' => sprintf('<li>Autorizacion Nro: %s</li>', $payment[0]->aut)),
          );
        } // if empty
      //}
      break;
  }
}
