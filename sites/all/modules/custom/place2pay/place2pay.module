   )));*/
} 
/**
* Implements hook_cron
* Run automatic task for payments between Municipality and Diners
*/
function place2pay_cron(){
  module_load_include('inc','place2pay','place2pay');
  concilliation_gim_p2p();
  concilliation_gim();
  $hora = date("h:i"); // hours and minutes  
  watchdog('Concilliation','Conciliacion automatica a las '. $hora .'',array(),WATCHDOG_INFO);   
}
