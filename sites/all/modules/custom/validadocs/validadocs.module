/*
 * HOOK Help
 */
function validadocs_help($path, $arg){
  $help = '';
  switch ($path) {
    case 'admin/help#validadocs':
      $help = "<h1>Ayuda para Valida certificado </h1>";
      $help .= t('This module is for get taxes from citizens</br>');
      $help .= t('This module work with webservices, from GIM</br>');
      $help .= t('Include payments too');
      break;
    
    default:
      # code...
      break;
  }  
  return $help;
}
